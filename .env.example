# Server-level settings only. Copy to .env if you want to change defaults.
#
# Where connection details come from depends on MCP_TRANSPORT:
#   stdio -> the ACC_* vars at the bottom of this file (single-tenant)
#   http  -> per-client X-ACC-* request headers (multi-tenant); the ACC_* vars
#            are ignored unless ACC_ALLOW_ENV_FALLBACK=true

# --- Behaviour ---
ACC_TIMEOUT_SECONDS=60
ACC_DEFAULT_PAGE_SIZE=200
ACC_MAX_ROWS=500
ACC_MAX_RESPONSE_CHARS=120000
ACC_MAX_RETRIES=3
ACC_VERIFY_TLS=true
ACC_LOG_LEVEL=INFO
ACC_MAX_CACHED_CONNECTIONS=32

# --- Transport ---
# stdio: Claude launches the server per client; no port, no manual start.
# http:  long-running server; clients identify their instance via headers.
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000

# --- Connection details: required for stdio, ignored by http ---
ACC_BASE_URL=
ACC_AUTH_MODE=native
ACC_LOGIN=
ACC_PASSWORD=

# http only: lets the ACC_* vars above stand in for missing headers.
# Has no effect under stdio, where env is already the only channel.
ACC_ALLOW_ENV_FALLBACK=false
